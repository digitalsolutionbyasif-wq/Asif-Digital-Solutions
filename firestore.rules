rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Read-only startup connectivity check document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Trusted admin lookup collection (manageable only via Firebase Console / Admin SDK)
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // Pillar 3: Hardened global primitive helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'digital.solution.by.asif@gmail.com' ||
        request.auth.token.email == 'asifriaz1297@gmail.com'
      );
    }

    // Pillar 2: Validation Blueprints matching firebase-blueprint.json strictly
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role == 'client'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectBrief(data, briefId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'serviceTrack', 'budgetEstimate',
          'aiSummary', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'serviceTrack', 'budgetEstimate',
          'notes', 'aiSummary', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == briefId
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.serviceTrack is string && data.serviceTrack.size() >= 2 && data.serviceTrack.size() <= 80
        && data.budgetEstimate is string && data.budgetEstimate.size() >= 2 && data.budgetEstimate.size() <= 60
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1500))
        && data.aiSummary is string && data.aiSummary.size() >= 4 && data.aiSummary.size() <= 3000
        && data.status in ['Draft', 'Submitted', 'Archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVoiceSession(data, sessionId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'mode', 'voiceName',
          'userTranscript', 'assistantTranscript', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'mode', 'voiceName',
          'userTranscript', 'assistantTranscript', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == sessionId
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.mode in ['Agency Scoping', 'Academy Advisor', 'FYP Architecture']
        && data.voiceName in ['Zephyr', 'Kore', 'Puck', 'Fenrir', 'Charon']
        && data.userTranscript is string && data.userTranscript.size() <= 3000
        && data.assistantTranscript is string && data.assistantTranscript.size() <= 4000
        && data.createdAt is timestamp;
    }

    function isValidCreativeAsset(data, assetId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'prompt', 'aspectRatio', 'imageSize', 'operation', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'prompt', 'aspectRatio', 'imageSize', 'operation', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == assetId
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.prompt is string && data.prompt.size() >= 2 && data.prompt.size() <= 800
        && data.aspectRatio in ['1:1', '4:3', '3:4', '16:9', '9:16']
        && data.imageSize in ['1K', '2K', '4K']
        && data.operation in ['generate', 'edit']
        && data.createdAt is timestamp;
    }

    // Pillar 6: PII Isolation - Private User Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && resource.data.uid == request.auth.uid;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);

      allow delete: if isValidId(userId) && isAdmin();

      // Pillar 1 & 4 & 5: Subcollection - Client AI Project Briefs
      match /briefs/{briefId} {
        allow get: if isValidId(userId) && isValidId(briefId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(briefId)
          && isOwner(userId)
          && isValidProjectBrief(incoming(), briefId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId) && isValidId(briefId)
          && isVerifiedUser()
          && isValidProjectBrief(incoming(), briefId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() || (
              isOwner(userId)
              && existing().status != 'Archived'
              && (
                incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'budgetEstimate', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              )
            )
          );

        allow delete: if isValidId(userId) && isValidId(briefId) && (isOwner(userId) || isAdmin());
      }

      // Subcollection - Voice Consultation Session Transcripts
      match /voiceSessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(sessionId)
          && isOwner(userId)
          && isValidVoiceSession(incoming(), sessionId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
      }

      // Subcollection - Creative Asset Studio History
      match /assets/{assetId} {
        allow get: if isValidId(userId) && isValidId(assetId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(assetId)
          && isOwner(userId)
          && isValidCreativeAsset(incoming(), assetId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(assetId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
